# Copiá este archivo como .env y completá tus propios valores.
# NO subas un archivo .env real con tus credenciales al repositorio.

# Connection string que te da Neon (Settings > Connection Details)
# Formato: jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/greenhouse_db?sslmode=require

# Usuario y contraseña que te da Neon
DB_USERNAME=tu_usuario_neon
DB_PASSWORD=tu_password_neon

# Secreto para firmar los JWT (generá uno propio, mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_unico

# Origen permitido para CORS (la URL donde corre tu Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# API key de Resend (resend.com/api-keys) para el envío de correos de
# recuperación de contraseña. Sin esto configurado, "olvidé mi contraseña"
# devuelve error 503 al intentar enviar el correo.
RESEND_API_KEY=
# Remitente. onboarding@resend.dev funciona sin verificar dominio propio.
RESEND_FROM_EMAIL=onboarding@resend.dev
